---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectsTeaser from "../../components/home/ProjectsTeaser.tsx";
import LocationsStrip from "../../components/home/LocationsStrip.tsx";
import { agences } from "../../data/projets";
import { buildLocationCards, allProjects } from "../../lib/locations";

const locations = buildLocationCards();
const flat = allProjects();
const totalImages = flat.reduce((s, x) => s + x.projet.imageCount, 0);
const heroCover = agences[0]?.cover ?? flat[0]?.projet.cover;
---

<BaseLayout
  title="Projets — Clivia Ambroise"
  description={`Quatre signatures d'agences d'architecture, ${flat.length} projets photographiés, ${totalImages} images. L'ensemble du portfolio de Clivia Ambroise.`}
  ogImage={heroCover}
>
  <section class="px-6 pt-40 pb-16 md:px-10 md:pt-56 md:pb-24">
    <div class="mx-auto max-w-[var(--container-wide)]">
      <p class="eyebrow mb-6">— Portfolio</p>
      <h1 class="font-display text-5xl leading-[1.04] tracking-[-0.015em] md:text-[clamp(4rem,9vw,9rem)] md:leading-[1.02]">
        Projets <span class="italic font-light">en cours</span><br />
        et <span class="italic font-light">archives</span>.
      </h1>
      <p class="mt-16 max-w-xl text-[0.95rem] leading-relaxed text-[var(--color-ink-soft)] md:mt-20">
        {agences.length} agences d'architecture, {flat.length} projets, {totalImages} photographies.
        Chaque projet est documenté en plusieurs reportages — choisissez une porte d'entrée
        par signature ou par lieu.
      </p>
    </div>
  </section>

  <ProjectsTeaser client:visible agences={agences} />

  <LocationsStrip client:visible locations={locations} />

  <section class="bg-[var(--color-bg)] px-6 py-24 md:px-10 md:py-32">
    <div class="mx-auto max-w-[var(--container-wide)]">
      <p class="eyebrow mb-6">— Index</p>
      <h2 class="font-display text-3xl leading-[1.1] md:text-5xl">Tout le travail, une page.</h2>
      <ul class="mt-12 grid grid-cols-1 gap-x-12 gap-y-1 md:grid-cols-2">
        {flat.map(({ projet, agence }, i) => (
          <li class="border-b border-[var(--color-line)]">
            <a
              href={`/agences/${agence.slug}/${projet.slug}`}
              data-cursor="link"
              class="group flex items-baseline justify-between gap-4 py-6 transition-colors hover:text-[var(--color-accent)]"
            >
              <span class="flex flex-1 items-baseline gap-5">
                <span class="text-xs tracking-[0.2em] uppercase text-[var(--color-mute)]">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="flex flex-col">
                  <span class="font-display text-2xl leading-[1.1] md:text-3xl">{projet.title}</span>
                  <span class="mt-1 text-[0.7rem] tracking-[0.2em] uppercase text-[var(--color-mute)]">
                    <em class="not-italic font-medium">{agence.name}</em> · {projet.location}{projet.year ? ` · ${projet.year}` : ""}
                  </span>
                </span>
              </span>
              <span class="text-xs tracking-[0.2em] uppercase text-[var(--color-mute)] transition-colors group-hover:text-[var(--color-accent)]">
                {projet.imageCount} <span class="opacity-70">photos</span> →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
