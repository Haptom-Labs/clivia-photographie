---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroFullBleed from "../../components/sections/HeroFullBleed.tsx";
import {
  buildLocationCards,
  projetsByLocationSlug,
  seriesForLocation,
} from "../../lib/locations";

export function getStaticPaths() {
  const cards = buildLocationCards();
  return cards.map((card) => ({
    params: { slug: card.slug },
    props: { card, projets: projetsByLocationSlug(card.slug) },
  }));
}

const { card, projets } = Astro.props;
const totalPhotos = projets.reduce((sum, p) => sum + p.imageCount, 0);
const titleParts = card.name.split(/[\s-]+/);
const titleTop = titleParts[0];
const titleBottom = titleParts.slice(1).join(" ") || titleParts[0];
---

<BaseLayout
  title={`${card.name} — Reportages photo · Clivia Ambroise`}
  description={`Photographies d'architecture sur ${card.name}. ${projets.length} projets, ${totalPhotos} photographies.`}
  ogImage={card.image}
>
  <HeroFullBleed
    client:load
    image={card.image}
    alt={`Photographie d'architecture — ${card.name}`}
    eyebrow="— Lieu"
    titleTop={titleTop}
    titleBottom={titleParts.length > 1 ? titleBottom : ""}
    subtitle={`${projets.length} ${projets.length > 1 ? "agences confiées" : "agence confiée"} · ${totalPhotos} photographies`}
    height="tall"
  />

  <section class="bg-[var(--color-bg)] px-6 py-14 md:px-10 md:py-24">
    <div class="mx-auto max-w-[var(--container-wide)]">
      <div class="grid gap-10 md:grid-cols-12 md:gap-12">
        <div class="md:col-span-4">
          <p class="eyebrow mb-4">— Territoire</p>
          <h2 class="font-display text-3xl leading-[1.06] md:text-[clamp(2rem,3vw,3.2rem)]">
            Projets photographiés sur <span class="italic font-light">{card.name}</span>.
          </h2>
        </div>
        <div class="md:col-span-8">
          <p class="text-[0.95rem] leading-relaxed text-[var(--color-ink-soft)] md:max-w-xl">
            Chaque agence aborde le territoire à sa manière. Voici les reportages
            réalisés sur {card.name}, par projet et par signature d'architecte.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-bg)] px-6 pt-4 pb-24 md:px-10 md:pt-8 md:pb-32">
    <div class="mx-auto max-w-[var(--container-wide)]">
      <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-x-8 md:gap-y-10">
        {projets.map((p) => {
          const localSeries = seriesForLocation(p, card.slug);
          const localCount = localSeries.reduce((sum, s) => sum + s.images.length, 0);
          const cover = localSeries[0]?.images[0] ?? p.cover;

          return (
            <li>
              <a
                href={`/projets/${p.slug}`}
                data-cursor="link"
                class="group block"
              >
                <div class="relative aspect-[4/5] overflow-hidden bg-[var(--color-ink)]">
                  <img
                    src={cover}
                    alt={`${p.title} — ${card.name}`}
                    loading="lazy"
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-[rgba(14,14,12,0.62)] via-[rgba(14,14,12,0.18)] to-transparent" />
                  <div class="absolute inset-x-0 bottom-0 p-6 text-[var(--color-bg)] md:p-8">
                    <p class="text-[0.66rem] tracking-[0.22em] uppercase opacity-85">
                      {p.client}
                    </p>
                    <h3 class="mt-3 font-display text-2xl leading-[1.04] transition-colors group-hover:text-[var(--color-accent)] md:text-3xl">
                      {p.title}
                    </h3>
                    <p class="mt-3 text-[0.7rem] tracking-[0.2em] uppercase opacity-70">
                      {localCount} photographies
                    </p>
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="bg-[var(--color-bg-warm)] px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto flex max-w-[var(--container-wide)] flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <p class="font-display text-2xl leading-[1.1] md:text-3xl">
        Voir tous les <span class="italic font-light">territoires</span>.
      </p>
      <a
        href="/#territoires"
        class="border-b border-[var(--color-ink)] pb-1 text-xs tracking-[0.22em] uppercase transition-colors hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]"
        data-cursor="link"
      >
        Retour à la carte →
      </a>
    </div>
  </section>
</BaseLayout>
