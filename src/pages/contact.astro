---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projets } from "../data/projets";

const heroImage =
  projets[2]?.images[3] ?? projets[0]?.images[1] ?? projets[0]?.cover;
---

<BaseLayout
  title="Contact — Clivia Ambroise"
  description="Photographe d'architecture indépendante. Bordeaux et déplacements. Devis sur mesure."
  ogImage={heroImage}
  hideFooter={true}
>
  <section class="grid min-h-[100svh] grid-cols-1 md:grid-cols-12">
    <div class="relative md:col-span-7">
      <img
        src={heroImage}
        alt="Photographie d'architecture par Clivia Ambroise"
        class="h-[60svh] w-full object-cover md:h-full md:absolute md:inset-0"
      />
    </div>

    <div class="md:col-span-5 flex flex-col justify-between bg-[var(--color-bg)] px-6 py-20 md:px-12 md:py-24">
      <div>
        <p class="eyebrow mb-6">— Contact</p>
        <h1 class="font-display text-4xl leading-[1.04] md:text-[clamp(2.6rem,4.4vw,4.8rem)]">
          Travaillons<br />
          <span class="italic font-light">ensemble.</span>
        </h1>
        <p class="mt-8 max-w-md text-[0.95rem] leading-relaxed text-[var(--color-ink-soft)]">
          Reportages d'architecture, intérieurs, lieux d'exception. Bordeaux et déplacements
          en France ou à l'étranger. Devis sur mesure selon le projet.
        </p>
      </div>

      <div class="mt-16 flex flex-col gap-8">
        <div>
          <p class="text-xs tracking-[0.22em] uppercase text-[var(--color-mute)]">Email</p>
          <a
            href="mailto:contact@cliviaambroise.com"
            data-cursor="link"
            class="mt-2 inline-block font-display text-2xl transition-colors hover:text-[var(--color-accent)]"
          >
            contact@cliviaambroise.com
          </a>
        </div>

        <div>
          <p class="text-xs tracking-[0.22em] uppercase text-[var(--color-mute)]">Studio</p>
          <p class="mt-2 font-display text-2xl">Bordeaux, Gironde</p>
          <p class="mt-1 text-sm text-[var(--color-mute)]">France</p>
        </div>

        <div>
          <p class="text-xs tracking-[0.22em] uppercase text-[var(--color-mute)]">Suivre</p>
          <a
            href="https://www.instagram.com/cliviaambroise_photographie/"
            target="_blank"
            rel="noopener"
            data-cursor="link"
            class="mt-2 inline-block font-display text-2xl transition-colors hover:text-[var(--color-accent)]"
          >
            @cliviaambroise_photographie
          </a>
        </div>
      </div>

      <div class="mt-16 border-t border-[var(--color-line)] pt-6 text-xs text-[var(--color-mute)]">
        <p>© {new Date().getFullYear()} Clivia Ambroise — Tous droits réservés</p>
      </div>
    </div>
  </section>
</BaseLayout>
