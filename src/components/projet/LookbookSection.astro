---
import ParallaxImage from "../sections/ParallaxImage.tsx";
import ImageReveal from "../sections/ImageReveal.tsx";
import StickyTextScroll from "../sections/StickyTextScroll.tsx";

interface Props {
  series: {
    location: string;
    title?: string;
    year: number | null;
    date: string;
    images: string[];
    postCount: number;
  };
  index: number;
  client: string;
}

const { series, index, client } = Astro.props;
const imgs = series.images;

// Découpage en blocs cinématiques avec séquence pseudo-aléatoire DÉTERMINISTE
// (cohérente entre rebuilds, mais variée entre projets via la seed = 1ère image).
// 1, 2 ou 3 images par ligne, ratios variés, style feed Pinterest artistique.
type Block =
  | { kind: "fullbleed"; src: string }
  | { kind: "fullbleed-narrow"; src: string }
  | { kind: "duo"; a: string; b: string }
  | { kind: "duo-portrait"; a: string; b: string }
  | { kind: "60-40"; a: string; b: string }
  | { kind: "40-60"; a: string; b: string }
  | { kind: "trio"; a: string; b: string; c: string }
  | { kind: "trio-staircase"; a: string; b: string; c: string }
  | { kind: "trio-asymmetric"; a: string; b: string; c: string };

// PRNG déterministe (mulberry32) — seed = somme codes ASCII de la 1ère image
function createPrng(seedStr: string) {
  let h = 0;
  for (let k = 0; k < seedStr.length; k++) h = (h * 31 + seedStr.charCodeAt(k)) >>> 0;
  return () => {
    h = (h + 0x6d2b79f5) >>> 0;
    let t = h;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const PATTERNS = [
  { kind: "fullbleed" as const, count: 1, weight: 2 },
  { kind: "fullbleed-narrow" as const, count: 1, weight: 1 },
  { kind: "duo" as const, count: 2, weight: 2 },
  { kind: "duo-portrait" as const, count: 2, weight: 1 },
  { kind: "60-40" as const, count: 2, weight: 2 },
  { kind: "40-60" as const, count: 2, weight: 2 },
  { kind: "trio" as const, count: 3, weight: 2 },
  { kind: "trio-staircase" as const, count: 3, weight: 1 },
  { kind: "trio-asymmetric" as const, count: 3, weight: 1 },
];

const blocks: Block[] = [];
const rng = createPrng(imgs[0] ?? series.location);
let i = 0;
let lastKind: string | null = null;
while (i < imgs.length) {
  const remaining = imgs.length - i;
  if (remaining === 1) {
    blocks.push({ kind: "fullbleed", src: imgs[i] });
    break;
  }
  if (remaining === 2) {
    const opts = ["duo", "duo-portrait", "60-40", "40-60"] as const;
    const pick = opts[Math.floor(rng() * opts.length)];
    blocks.push({ kind: pick, a: imgs[i], b: imgs[i + 1] } as Block);
    break;
  }
  // remaining >= 3 → on tire selon les poids, en évitant 2 fois de suite le même
  const candidates = PATTERNS.filter((p) => p.count <= remaining && p.kind !== lastKind);
  const totalWeight = candidates.reduce((s, p) => s + p.weight, 0);
  let r = rng() * totalWeight;
  const picked = candidates.find((p) => (r -= p.weight) <= 0) ?? candidates[0];
  if (picked.count === 1) {
    blocks.push({ kind: picked.kind, src: imgs[i] } as Block);
  } else if (picked.count === 2) {
    blocks.push({ kind: picked.kind, a: imgs[i], b: imgs[i + 1] } as Block);
  } else {
    blocks.push({ kind: picked.kind, a: imgs[i], b: imgs[i + 1], c: imgs[i + 2] } as Block);
  }
  i += picked.count;
  lastKind = picked.kind;
}

const sectionId = `serie-${series.location.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-${index}`;
---

<section id={sectionId} class="bg-[var(--color-bg)]">
  <header class={`mx-auto max-w-[var(--container-wide)] px-6 pb-6 md:px-10 md:pb-16 ${index === 0 ? "pt-8 md:pt-12" : "pt-16 md:pt-32"}`}>
    <div class="grid gap-4 md:grid-cols-12 md:items-end md:gap-6">
      <div class="md:col-span-3">
        <p class="eyebrow">— Série {String(index + 1).padStart(2, "0")}</p>
      </div>
      <div class="md:col-span-9">
        <h2 class="font-display text-4xl leading-[1.04] md:text-[clamp(2.6rem,5vw,5.4rem)]">
          {series.title ?? series.location}
        </h2>
        <p class="mt-3 text-sm tracking-[0.2em] uppercase text-[var(--color-mute)] md:mt-4">
          {series.title ? <span>{series.location} · </span> : null}
          {client}
          {series.year && <span> · {series.year}</span>}
          <span> · {imgs.length} photographies</span>
        </p>
      </div>
    </div>
  </header>

  <!-- Mobile: feed Pinterest masonry (column-based, hauteurs aléatoires) -->
  <div class="md:hidden columns-2 gap-2 px-2">
    {imgs.map((src, idx) => {
      const ratios = [
        "aspect-[4/5]",
        "aspect-[3/4]",
        "aspect-[1/1]",
        "aspect-[5/4]",
        "aspect-[4/5]",
        "aspect-[3/4]",
        "aspect-[2/3]",
        "aspect-[1/1]",
      ];
      const r = ratios[idx % ratios.length];
      return (
        <div class={`reveal-mobile mb-2 break-inside-avoid relative overflow-hidden bg-[var(--color-ink)] ${r}`}>
          <img
            src={src}
            alt={`${series.title ?? series.location} ${idx + 1}`}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      );
    })}
  </div>

  <!-- Desktop: blocs cinématiques -->
  <div class="hidden md:flex md:flex-col md:gap-20">
    {blocks.map((b, idx) => {
      if (b.kind === "fullbleed") {
        return (
          <ParallaxImage
            src={b.src}
            alt={`${series.location} — ${client} ${idx + 1}`}
            ratio="fullbleed"
            client:visible
          />
        );
      }
      if (b.kind === "fullbleed-narrow") {
        return (
          <div class="mx-auto w-full max-w-[var(--container-wide)] px-2 md:px-16">
            <ImageReveal src={b.src} alt={`${series.location} ${idx + 1}`} ratio="16/9" reveal="up" client:visible />
          </div>
        );
      }
      if (b.kind === "60-40") {
        return (
          <div class="mx-auto flex w-full max-w-[var(--container-wide)] flex-col gap-3 px-2 md:grid md:grid-cols-12 md:gap-6 md:px-8">
            <div class="w-full self-start md:col-span-7 md:w-auto">
              <ImageReveal src={b.a} alt={`${series.location} ${idx} a`} ratio="4/5" reveal="up" client:visible />
            </div>
            <div class="w-[94%] self-end md:col-span-5 md:w-auto md:self-auto">
              <ImageReveal src={b.b} alt={`${series.location} ${idx} b`} ratio="3/4" reveal="left" client:visible />
            </div>
          </div>
        );
      }
      if (b.kind === "40-60") {
        return (
          <div class="mx-auto flex w-full max-w-[var(--container-wide)] flex-col gap-3 px-2 md:grid md:grid-cols-12 md:gap-6 md:px-8">
            <div class="w-[94%] self-start md:col-span-5 md:w-auto md:self-auto">
              <ImageReveal src={b.a} alt={`${series.location} ${idx} a`} ratio="3/4" reveal="right" client:visible />
            </div>
            <div class="w-full self-end md:col-span-7 md:w-auto">
              <ImageReveal src={b.b} alt={`${series.location} ${idx} b`} ratio="4/5" reveal="up" client:visible />
            </div>
          </div>
        );
      }
      if (b.kind === "duo") {
        return (
          <div class="mx-auto flex w-full max-w-[var(--container-wide)] flex-col gap-3 px-2 md:grid md:grid-cols-2 md:gap-6 md:px-8">
            <div class="w-[97%] self-start md:w-auto md:self-auto">
              <ImageReveal src={b.a} alt={`${series.location} ${idx} a`} ratio="1/1" reveal="up" client:visible />
            </div>
            <div class="w-[97%] self-end md:w-auto md:self-auto">
              <ImageReveal src={b.b} alt={`${series.location} ${idx} b`} ratio="1/1" reveal="left" client:visible />
            </div>
          </div>
        );
      }
      if (b.kind === "duo-portrait") {
        return (
          <div class="mx-auto flex w-full max-w-[var(--container-wide)] flex-col gap-3 px-2 md:grid md:grid-cols-2 md:gap-10 md:px-16">
            <div class="md:mt-0">
              <ImageReveal src={b.a} alt={`${series.location} ${idx} a`} ratio="3/4" reveal="up" client:visible />
            </div>
            <div class="md:mt-16">
              <ImageReveal src={b.b} alt={`${series.location} ${idx} b`} ratio="3/4" reveal="up" client:visible />
            </div>
          </div>
        );
      }
      if (b.kind === "trio") {
        return (
          <div class="mx-auto flex w-full max-w-[var(--container-wide)] flex-col gap-3 px-2 md:grid md:grid-cols-3 md:gap-6 md:px-8">
            <div class="w-full self-start md:w-auto md:self-auto">
              <ImageReveal src={b.a} alt={`${series.location} ${idx} a`} ratio="3/4" reveal="up" client:visible />
            </div>
            <div class="w-[94%] self-end md:w-auto md:self-auto">
              <ImageReveal src={b.b} alt={`${series.location} ${idx} b`} ratio="4/5" reveal="left" client:visible />
            </div>
            <div class="w-[96%] self-start md:w-auto md:self-auto">
              <ImageReveal src={b.c} alt={`${series.location} ${idx} c`} ratio="3/4" reveal="up" client:visible />
            </div>
          </div>
        );
      }
      if (b.kind === "trio-staircase") {
        return (
          <div class="mx-auto flex w-full max-w-[var(--container-wide)] flex-col gap-3 px-2 md:grid md:grid-cols-3 md:gap-6 md:px-8">
            <div class="md:mt-0">
              <ImageReveal src={b.a} alt={`${series.location} ${idx} a`} ratio="4/5" reveal="up" client:visible />
            </div>
            <div class="md:mt-16">
              <ImageReveal src={b.b} alt={`${series.location} ${idx} b`} ratio="4/5" reveal="up" client:visible />
            </div>
            <div class="md:mt-32">
              <ImageReveal src={b.c} alt={`${series.location} ${idx} c`} ratio="4/5" reveal="up" client:visible />
            </div>
          </div>
        );
      }
      if (b.kind === "trio-asymmetric") {
        return (
          <div class="mx-auto flex w-full max-w-[var(--container-wide)] flex-col gap-3 px-2 md:grid md:grid-cols-12 md:gap-6 md:px-8">
            <div class="md:col-span-5">
              <ImageReveal src={b.a} alt={`${series.location} ${idx} a`} ratio="4/5" reveal="right" client:visible />
            </div>
            <div class="md:col-span-3 md:mt-24">
              <ImageReveal src={b.b} alt={`${series.location} ${idx} b`} ratio="3/4" reveal="up" client:visible />
            </div>
            <div class="md:col-span-4 md:mt-8">
              <ImageReveal src={b.c} alt={`${series.location} ${idx} c`} ratio="1/1" reveal="left" client:visible />
            </div>
          </div>
        );
      }
      return null;
    })}
  </div>
</section>
