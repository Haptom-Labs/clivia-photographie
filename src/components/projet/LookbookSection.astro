---
import ParallaxImage from "../sections/ParallaxImage.tsx";
import ImageReveal from "../sections/ImageReveal.tsx";
import StickyTextScroll from "../sections/StickyTextScroll.tsx";

interface Props {
  series: {
    location: string;
    title?: string;
    year: number | null;
    date: string;
    images: string[];
    postCount: number;
  };
  index: number;
  client: string;
}

const { series, index, client } = Astro.props;
const imgs = series.images;

// Découpage déterministe en blocs cinématiques selon le nb d'images
type Block =
  | { kind: "fullbleed"; src: string }
  | { kind: "duo"; a: string; b: string }
  | { kind: "60-40"; a: string; b: string }
  | { kind: "40-60"; a: string; b: string }
  | { kind: "trio"; a: string; b: string; c: string }
  | { kind: "sticky"; imgs: string[]; eyebrow: string; title: string; body: string };

const blocks: Block[] = [];
let i = 0;
let blockIdx = 0;
while (i < imgs.length) {
  const remaining = imgs.length - i;
  const cycle = blockIdx % 6;
  if (remaining === 1) {
    blocks.push({ kind: "fullbleed", src: imgs[i] });
    i += 1;
  } else if (cycle === 0) {
    blocks.push({ kind: "fullbleed", src: imgs[i] });
    i += 1;
  } else if (cycle === 1 && remaining >= 2) {
    blocks.push({ kind: "60-40", a: imgs[i], b: imgs[i + 1] });
    i += 2;
  } else if (cycle === 2 && remaining >= 3) {
    blocks.push({ kind: "trio", a: imgs[i], b: imgs[i + 1], c: imgs[i + 2] });
    i += 3;
  } else if (cycle === 3 && remaining >= 2) {
    blocks.push({ kind: "duo", a: imgs[i], b: imgs[i + 1] });
    i += 2;
  } else if (cycle === 4) {
    blocks.push({ kind: "fullbleed", src: imgs[i] });
    i += 1;
  } else if (cycle === 5 && remaining >= 2) {
    blocks.push({ kind: "40-60", a: imgs[i], b: imgs[i + 1] });
    i += 2;
  } else {
    blocks.push({ kind: "fullbleed", src: imgs[i] });
    i += 1;
  }
  blockIdx += 1;
}

const sectionId = `serie-${series.location.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-${index}`;
---

<section id={sectionId} class="bg-[var(--color-bg)]">
  <header class={`mx-auto max-w-[var(--container-wide)] px-6 pb-6 md:px-10 md:pb-16 ${index === 0 ? "pt-8 md:pt-12" : "pt-16 md:pt-32"}`}>
    <div class="grid gap-4 md:grid-cols-12 md:items-end md:gap-6">
      <div class="md:col-span-3">
        <p class="eyebrow">— Série {String(index + 1).padStart(2, "0")}</p>
      </div>
      <div class="md:col-span-9">
        <h2 class="font-display text-4xl leading-[1.04] md:text-[clamp(2.6rem,5vw,5.4rem)]">
          {series.title ?? series.location}
        </h2>
        <p class="mt-3 text-sm tracking-[0.2em] uppercase text-[var(--color-mute)] md:mt-4">
          {series.title ? <span>{series.location} · </span> : null}
          {client}
          {series.year && <span> · {series.year}</span>}
          <span> · {imgs.length} photographies</span>
        </p>
      </div>
    </div>
  </header>

  <!-- Mobile: feed Pinterest masonry (column-based, hauteurs aléatoires) -->
  <div class="md:hidden columns-2 gap-2 px-2">
    {imgs.map((src, idx) => {
      const ratios = [
        "aspect-[4/5]",
        "aspect-[3/4]",
        "aspect-[1/1]",
        "aspect-[5/4]",
        "aspect-[4/5]",
        "aspect-[3/4]",
        "aspect-[2/3]",
        "aspect-[1/1]",
      ];
      const r = ratios[idx % ratios.length];
      return (
        <div class={`mb-2 break-inside-avoid relative overflow-hidden bg-[var(--color-ink)] ${r}`}>
          <img
            src={src}
            alt={`${series.title ?? series.location} ${idx + 1}`}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      );
    })}
  </div>

  <!-- Desktop: blocs cinématiques -->
  <div class="hidden md:flex md:flex-col md:gap-20">
    {blocks.map((b, idx) => {
      if (b.kind === "fullbleed") {
        return (
          <ParallaxImage
            src={b.src}
            alt={`${series.location} — ${client} ${idx + 1}`}
            ratio="fullbleed"
            client:visible
          />
        );
      }
      if (b.kind === "60-40") {
        return (
          <div class="mx-auto flex w-full max-w-[var(--container-wide)] flex-col gap-3 px-2 md:grid md:grid-cols-12 md:gap-6 md:px-8">
            <div class="w-full self-start md:col-span-7 md:w-auto">
              <ImageReveal src={b.a} alt={`${series.location} ${idx} a`} ratio="4/5" reveal="up" client:visible />
            </div>
            <div class="w-[94%] self-end md:col-span-5 md:w-auto md:self-auto">
              <ImageReveal src={b.b} alt={`${series.location} ${idx} b`} ratio="3/4" reveal="left" client:visible />
            </div>
          </div>
        );
      }
      if (b.kind === "40-60") {
        return (
          <div class="mx-auto flex w-full max-w-[var(--container-wide)] flex-col gap-3 px-2 md:grid md:grid-cols-12 md:gap-6 md:px-8">
            <div class="w-[94%] self-start md:col-span-5 md:w-auto md:self-auto">
              <ImageReveal src={b.a} alt={`${series.location} ${idx} a`} ratio="3/4" reveal="right" client:visible />
            </div>
            <div class="w-full self-end md:col-span-7 md:w-auto">
              <ImageReveal src={b.b} alt={`${series.location} ${idx} b`} ratio="4/5" reveal="up" client:visible />
            </div>
          </div>
        );
      }
      if (b.kind === "duo") {
        return (
          <div class="mx-auto flex w-full max-w-[var(--container-wide)] flex-col gap-3 px-2 md:grid md:grid-cols-2 md:gap-6 md:px-8">
            <div class="w-[97%] self-start md:w-auto md:self-auto">
              <ImageReveal src={b.a} alt={`${series.location} ${idx} a`} ratio="1/1" reveal="up" client:visible />
            </div>
            <div class="w-[97%] self-end md:w-auto md:self-auto">
              <ImageReveal src={b.b} alt={`${series.location} ${idx} b`} ratio="1/1" reveal="left" client:visible />
            </div>
          </div>
        );
      }
      if (b.kind === "trio") {
        return (
          <div class="mx-auto flex w-full max-w-[var(--container-wide)] flex-col gap-3 px-2 md:grid md:grid-cols-3 md:gap-6 md:px-8">
            <div class="w-full self-start md:w-auto md:self-auto">
              <ImageReveal src={b.a} alt={`${series.location} ${idx} a`} ratio="3/4" reveal="up" client:visible />
            </div>
            <div class="w-[94%] self-end md:w-auto md:self-auto">
              <ImageReveal src={b.b} alt={`${series.location} ${idx} b`} ratio="4/5" reveal="left" client:visible />
            </div>
            <div class="w-[96%] self-start md:w-auto md:self-auto">
              <ImageReveal src={b.c} alt={`${series.location} ${idx} c`} ratio="3/4" reveal="up" client:visible />
            </div>
          </div>
        );
      }
      return null;
    })}
  </div>
</section>
