---
const path = Astro.url.pathname;
const isHome = path === "/";
const items = [
  { href: "/projets", label: "Projets" },
  { href: "/a-propos", label: "À propos" },
  { href: "/contact", label: "Contact" },
];
---

<header
  class:list={[
    "fixed inset-x-0 top-0 z-50 transition-[background,backdrop-filter] duration-500",
    isHome ? "bg-transparent" : "bg-[color-mix(in_oklab,var(--color-bg)_82%,transparent)] backdrop-blur-md",
  ]}
  data-nav
>
  <div class="mx-auto flex h-16 max-w-[var(--container-wide)] items-center justify-between px-6 md:h-20 md:px-10">
    <a
      href="/"
      class="font-display text-[1.05rem] tracking-tight md:text-[1.15rem]"
      aria-label="Clivia Ambroise — Accueil"
    >
      <span class="font-medium">Clivia Ambroise</span>
      <span class="ml-1 hidden text-[var(--color-mute)] md:inline">— Photographe</span>
    </a>

    <nav class="flex items-center gap-7 text-[0.78rem] font-medium tracking-[0.18em] uppercase md:gap-9">
      {
        items.map((item) => (
          <a
            href={item.href}
            class:list={[
              "transition-opacity hover:opacity-60",
              path.startsWith(item.href) && "underline decoration-[var(--color-accent)] underline-offset-[6px]",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const isHome = location.pathname === "/";
    let last = 0;
    const onScroll = () => {
      const y = window.scrollY;
      if (isHome) {
        if (y > 60) {
          nav.classList.remove("bg-transparent");
          nav.classList.add("bg-[color-mix(in_oklab,var(--color-bg)_82%,transparent)]", "backdrop-blur-md");
        } else {
          nav.classList.add("bg-transparent");
          nav.classList.remove("bg-[color-mix(in_oklab,var(--color-bg)_82%,transparent)]", "backdrop-blur-md");
        }
      }
      if (y > 120 && y > last) {
        nav.style.transform = "translateY(-100%)";
      } else {
        nav.style.transform = "translateY(0)";
      }
      last = y;
    };
    nav.style.transition = "transform .5s cubic-bezier(.6,.05,.05,1), background .4s, backdrop-filter .4s";
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
