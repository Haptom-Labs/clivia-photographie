---
import ParallaxImage from "./ParallaxImage.tsx";
import ImageReveal from "./ImageReveal.tsx";

interface Props {
  image: string;
  alt?: string;
  imagePosition?: "left" | "right";
  ratio?: "4/5" | "3/4" | "1/1" | "16/9";
  variant?: "parallax" | "reveal";
  eyebrow?: string;
  title?: string;
  body?: string;
  meta?: string;
  contentBg?: "warm" | "bg" | "ink";
}

const {
  image,
  alt = "",
  imagePosition = "left",
  ratio = "4/5",
  variant = "parallax",
  eyebrow,
  title,
  body,
  meta,
  contentBg = "bg",
} = Astro.props;

const bgCls =
  contentBg === "warm"
    ? "bg-[var(--color-bg-warm)]"
    : contentBg === "ink"
      ? "bg-[var(--color-ink)] text-[var(--color-bg)]"
      : "bg-[var(--color-bg)]";
---

<section class={`grid items-stretch gap-0 md:grid-cols-12 md:gap-0 ${bgCls}`}>
  <div
    class:list={[
      "relative h-[68svh] md:h-auto md:col-span-7",
      imagePosition === "right" && "md:order-2",
    ]}
  >
    <div class="md:hidden absolute inset-0">
      {variant === "parallax" ? (
        <ParallaxImage src={image} alt={alt} ratio="fullbleed" client:visible />
      ) : (
        <ImageReveal src={image} alt={alt} ratio="3/4" reveal="up" client:visible />
      )}
    </div>
    <div class="hidden md:block">
      {variant === "parallax" ? (
        <ParallaxImage src={image} alt={alt} ratio={ratio} client:visible />
      ) : (
        <ImageReveal src={image} alt={alt} ratio={ratio} reveal="up" client:visible />
      )}
    </div>

    {(eyebrow || title) && (
      <div class="md:hidden pointer-events-none absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-[rgba(14,14,12,0.78)] via-[rgba(14,14,12,0.25)] to-transparent px-6 pt-24 pb-8 text-[var(--color-bg)]">
        {eyebrow && (
          <p class="eyebrow opacity-80" style="color: var(--color-bg);">
            {eyebrow}
          </p>
        )}
        {title && (
          <h2 class="mt-3 font-display text-[clamp(2rem,8.5vw,3.4rem)] leading-[1.02] tracking-[-0.012em]">
            {title}
          </h2>
        )}
      </div>
    )}
  </div>

  <div
    class:list={[
      "md:col-span-5 flex flex-col justify-center px-6 py-10 md:px-12 md:py-24",
      imagePosition === "right" && "md:order-1",
    ]}
  >
    {eyebrow && <p class="eyebrow mb-5 hidden md:block">{eyebrow}</p>}
    {title && (
      <h2 class="hidden font-display md:block md:text-[clamp(2.4rem,4.2vw,4.4rem)] md:leading-[1.04]">
        {title}
      </h2>
    )}
    {body && (
      <p class="max-w-md text-[0.95rem] leading-relaxed text-[var(--color-ink-soft)] md:mt-6">
        {body}
      </p>
    )}
    {meta && (
      <p class="mt-8 text-xs tracking-[0.2em] uppercase text-[var(--color-mute)] md:mt-10">
        {meta}
      </p>
    )}
    <slot />
  </div>
</section>
